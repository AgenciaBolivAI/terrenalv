# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.production holds ONLY the two public Supabase values (the anon key ships
# in the browser bundle by design; RLS is what protects the data). Committing
# them means a fresh deploy renders the map with no dashboard setup. Real
# secrets — SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, TURNSTILE_SECRET_KEY —
# stay in Vercel env vars, which override anything here.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
