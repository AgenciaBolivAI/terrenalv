# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Surveyor's CAD source for the plano (28 MB, and this repo is public).
# cad/*.py and cad/plano.json are committed — they are the extraction.
cad/*.dwg
cad/*.pdf
cad/faces.json
cad/plano_raw.json
cad/preview.png
cad/preview.svg

__pycache__/
*.pyc
